#include <stdio.h>
#include <math.h>

int main() {
    int T;
	float finish,distancetoBolt,tigerAccelaration,boltSpeed;
	float timeBolt, timeTiger;
	scanf("%d", &T);
	while(T--){
	    scanf("%f %f %f %f", &finish ,&distancetoBolt, &tigerAccelaration, &boltSpeed);
	    timeBolt = (finish/boltSpeed);
	    timeTiger = pow(((2*(finish+distancetoBolt))/tigerAccelaration),0.5);
	    printf("%s\n", (timeBolt<timeTiger)?"Bolt":"Tiger");
	}
	return 0;
}

