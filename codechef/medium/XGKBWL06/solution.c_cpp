#include <stdio.h>

int compare(int a,int b){
    if(a<b) return -1;
    else if (a==b) return 0;
    else return 1;
}



int main() {
    int num1, num2;
    scanf("%d %d", &num1, &num2);

    int result = compare(num1, num2);
    if (result == -1) printf("First number is smaller\n");
    else if (result == 0) printf("Numbers are equal\n");
    else printf("First number is greater\n");

    return 0;
}