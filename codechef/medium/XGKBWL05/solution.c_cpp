#include <stdio.h>
#include <string.h>

int isVowel(char ch) {
    if(ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u' || ch=='A' || ch=='E' ||ch=='I' || ch=='O' || ch=='U')
    return 1;
    else
    return 0;
   
   
}

int main() {
    char str[101];
    fgets(str, 101, stdin);

    int count = 0;
    for (int i = 0; i < strlen(str); i++) {
        if (isVowel(str[i])) {
            count++;
        }
    }

    printf("%d\n", count);

    return 0;
}