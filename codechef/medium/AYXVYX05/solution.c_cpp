#include <stdio.h>

#define SIZE 5

int main() {
    int playlist[SIZE];
    int i;

    for (i = 0; i < SIZE; i++) {
        scanf("%d", & playlist[i]);
    }

    int temp = playlist[SIZE - 1];
    for (i = SIZE - 1; i > 0; i--) {
        playlist[i] = playlist[i - 1];

    }
    playlist[0] = temp;



    for (i = 0; i < SIZE; i++) {
        printf("%d ", playlist[i]);
    }
    printf("\n");

    return 0;
}