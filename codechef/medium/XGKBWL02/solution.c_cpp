#include <stdio.h>

int add(int a, int b) {
    return (a+b);
    
}


int square(int num) {
    return (num*num);
    
}

int main() {
    int score1, score2;
    scanf("%d %d", &score1, &score2);

   
    int synergy_score = square(add(score1,score2));

    printf("%d\n", synergy_score);

    return 0;
}